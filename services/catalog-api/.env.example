# Same Neon connection string the Next.js app uses (read-only role recommended)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# Required for /search/ai; without it the endpoint falls back to keyword search
ANTHROPIC_API_KEY=
# Shared secret for admin endpoints (send as X-API-Key header). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=
