# Copy this file to .env and fill in real values.
# Both Next.js and drizzle-kit read from .env automatically.

# Neon Postgres connection string (get this from your Neon project dashboard,
# "Connect" button — use the pooled connection string).
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Random secret used to sign customer login session cookies. Generate one
# with `openssl rand -hex 32` and keep it private — anyone with this value
# can forge a signed-in session for any account.
AUTH_SECRET=change-me-too

# There is no admin password. /admin access is granted per-account via the
# users.is_admin column — sign up for a normal account, then flip that
# column to true for whichever emails should have admin access.

# Sentry error monitoring. Not a secret (DSNs are meant to be public), but
# kept as an env var so it can be rotated without a code change. Get this
# from sentry.io → your project → Settings → Client Keys (DSN).
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
