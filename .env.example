# Copy this file to .env and fill in real values.
# Both Next.js and drizzle-kit read from .env automatically.

# Neon Postgres connection string (get this from your Neon project dashboard,
# "Connect" button — use the pooled connection string).
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Password for the /admin dashboard. Pick anything you like — this is the
# only thing gating /admin, so keep it reasonably private.
ADMIN_PASSWORD=change-me

# Random secret used to sign customer login session cookies. Generate one
# with `openssl rand -hex 32` and keep it private — anyone with this value
# can forge a signed-in session for any account.
AUTH_SECRET=change-me-too
